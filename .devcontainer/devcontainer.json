{
  "name": "CarBids Studio",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "waitFor": "postCreateCommand",
  "forwardPorts": [8501, 8000],
  "portsAttributes": {"8501": {"label": "CarBids Studio", "onAutoForward": "openBrowser"}},
  "postAttachCommand": "bash scripts/start-studio.sh"
}
